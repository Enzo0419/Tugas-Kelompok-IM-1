  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\tAnoa, hewan endemik Sulawesi dari famili Bovidae yang sering dijuluki
    \"kerbau mini\", terdiri dari dua spesies yaitu anoa dataran rendah (Bubalus
    depressicornis) dan anoa pegunungan (Bubalus quarlesi). Anoa berperan penting
    dalam menjaga keseimbangan ekosistem hutan tropis melalui pola makannya yang
    membantu penyebaran benih. Keunikan dan keterbatasan habitatnya menjadikan anoa
    spesies yang sangat penting untuk dilestarikan, serta memiliki nilai budaya tinggi
    bagi masyarakat lokal Sulawesi sebagai simbol kekuatan\_dan\_ketahanan."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
