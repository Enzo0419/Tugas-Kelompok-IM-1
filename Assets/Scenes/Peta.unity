  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\tBurung Kasuari (Casuarius spp.) adalah burung besar yang hidup di hutan
    hujan tropis Papua, Papua Nugini, dan Australia Utara. Burung ini terkenal dengan
    tubuhnya yang besar dan kuat, bulu hitam lebat, leher berwarna cerah kebiruan
    atau kemerahan, serta tanduk (helm) keras di kepalanya. Kasuari tidak bisa terbang,
    tetapi sangat gesit dan mampu berlari cepat menembus lebatnya hutan. Burung ini
    juga dikenal agresif jika merasa terancam. Kasuari berperan penting menjaga keseimbangan
    ekosistem hutan sebagai\_penyebar\_biji."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
