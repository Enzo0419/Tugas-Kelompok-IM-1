  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\tKomodo (Varanus komodoensis) adalah kadal terbesar di dunia yang hanya
    ditemukan di beberapa pulau di Indonesia, seperti Pulau Komodo, Rinca, Gili Motang,
    dan Flores. Komodo memiliki tubuh besar, kulit bersisik kasar, dan lidah panjang
    yang bercabang. Reptil ini adalah predator puncak yang memangsa rusa, babi hutan,
    dan bangkai. Komodo terancam punah akibat perburuan dan kerusakan habitat, sehingga
    kini dilindungi dan menjadi simbol konservasi satwa\_liar\_Indonesia."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
