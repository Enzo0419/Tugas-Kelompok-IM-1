  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\tBurung cendrawasih, dikenal sebagai \"burung surga\", merupakan simbol
    keanekaragaman hayati Indonesia, terutama di Papua dan sekitarnya, dengan ciri
    khas bulu berwarna cerah seperti kuning, merah, hijau, biru, dan hitam dalam
    kombinasi mencolok. Burung jantan menggunakan bulu spektakulernya, termasuk ekor
    panjang dan ornamen unik seperti pita atau kipas, untuk menarik perhatian betina
    saat musim kawin. Ukurannya bervariasi dari kecil hingga sedang, dan habitat
    aslinya berada di hutan tropis lembab dataran rendah hingga pegunungan, khususnya
    di kanopi hutan\_yang\_tinggi."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
