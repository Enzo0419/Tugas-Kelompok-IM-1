  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\tElang jawa (Nisaetus bartelsi) adalah burung endemik Pulau Jawa yang
    karismatik, dikenali dari jambul khas, mata kuning tajam, paruh melengkung, serta
    cakar kuat. Dengan panjang tubuh 60\u201370 cm dan bentang sayap lebih dari satu
    meter, burung ini menunjukkan fenomena reversed sexual dimorphism, di mana betina
    lebih besar dari jantan. Sebagai predator langka dan dilindungi, elang jawa hanya
    berpopulasi sekitar 300\u2013500 individu di Jawa dan Bali, terancam oleh perburuan
    liar, penyusutan habitat, dan laju reproduksi yang lambat\u2014karena betina
    hanya bertelur satu butir setiap musim dan membutuhkan waktu lama untuk membesarkan\_anaknya."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
