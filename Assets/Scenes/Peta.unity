  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\tHarimau sumatera (Panthera tigris sumatrae) adalah salah satu dari enam
    subspesies harimau yang masih hidup dan kini berstatus kritis (Critically Endangered).
    Provinsi Riau menjadi habitat sepertiga populasi harimau ini, termasuk di Taman
    Nasional Bukit Tigapuluh (TNBT), yang menurut data YPKHS dan Balai TNBT tahun
    2017 dihuni oleh 47 ekor, meningkat dari 35 ekor pada pendataan awal. Meski ada
    peningkatan, jumlah tersebut masih tergolong sangat kecil dibandingkan satwa
    lain, sehingga pelestariannya\_sangat\_penting."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
